# Copy to backend/.env and fill in real values:  cp backend/.env.example backend/.env
# `docker compose up` reads backend/.env (see docker-compose.yml env_file).
# uvicorn run locally from backend/ also picks it up (config.py load_dotenv()).
# Never commit backend/.env.

# --- Supabase (backend) ------------------------------------------------------
# From your Supabase project: Settings > API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the SERVICE ROLE key, not the anon key. The backend calls the Supabase
# admin API (auth.admin.create_user / update_user_by_id / list_users) and
# writes rows on the user's behalf; the anon key cannot do that and RLS would
# block the writes. Keep this secret - it bypasses Row Level Security.
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Gemini (backend) ------------------------------------------------------
# Google AI Studio API key for gemini-2.5-flash (Vision OCR + RAG classifier).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- CORS (backend) ------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Dev default is localhost:5173 (Vite) + localhost:3000 (docker frontend).
# For a deployed host, set this to your frontend's public origin, e.g.
#   CORS_ORIGINS=https://tictaxflow.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Backend debug ------------------------------------------------------
# "true"/"1"/"yes" surfaces full exception detail in API error responses.
# Leave False for anything shared.
DEBUG_ERRORS=False

# --- Frontend (build-time) ------------------------------------------------------
# Vite inlines this into the JS bundle when the frontend image is built, so it
# must be set BEFORE `docker compose build`, not at container runtime.
# Must be the PUBLIC URL of the backend API including the /api/v1 suffix.
#   local dev / docker on your machine: http://localhost:8000/api/v1
#   deployed:                           https://api.tictaxflow.example.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
